# Copy this file to home/.secrets.zsh on a new machine. That copy is gitignored
# and never committed - this template is the only version that lives in git.
#
#   cp home/.secrets.zsh.example home/.secrets.zsh
#
# Anything exported here is available to your shell and to anything started from
# it. Do not put secrets in home/.zshrc itself: that file is tracked.

# Tokens and passwords
# export SOME_API_TOKEN="..."

# Cluster / infra endpoints
# export VAULT_ADDR="https://vault.example.com"
# export KUBECONFIG="$HOME/.kube/config-staging"

# Anything else that is yours alone and not a default worth sharing
# export CLUSTER_NAME="prod-eu-1"
