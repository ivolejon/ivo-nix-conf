# local secrets, per machine - home/.secrets.zsh.example is the tracked template
home/.secrets.zsh

# macOS + nix build noise
home/.config/zed/prompts/**
.DS_Store
result
result-*

# no-mistakes local validation state - never commit in this public repo
.no-mistakes/